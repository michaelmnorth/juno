# Copy to gateway/slack.env (git-ignored). Values are 1Password references, resolved only inside `op run`.
# Create item "Slack-Juno" in the Agent-Secrets vault with fields bot_token and app_token.
SLACK_BOT_TOKEN=op://Agent-Secrets/Slack-Juno/bot_token
SLACK_APP_TOKEN=op://Agent-Secrets/Slack-Juno/app_token
# Optional overrides
# CLAUDE_BIN is auto-detected (PATH, npm, or the desktop app's bundled copy under
# %APPDATA%\Claude\claude-code\<version>\<hash>\claude.exe). Override only if detection picks the wrong one:
# CLAUDE_BIN=C:\Users\Michael\AppData\Roaming\Claude\claude-code\2.1.317\a33aa5518497\claude.exe
# CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_MODEL=sonnet
# SLACK_ALLOWED_USERS=U0XXXXXXX   (normally comes from me/notify-allowlist.json)
